<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BẢNG TỔNG HỢP KÈO PICKLEBALL</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            800: '#1e293b',
                            900: '#0f172a',
                            950: '#020617',
                        },
                        sheet: {
                            header: '#1b365d',
                            accent: '#2563eb',
                            gold: '#d97706',
                            danger: '#dc2626',
                            success: '#16a34a',
                            bg: '#f8fafc',
                        }
                    },
                    fontFamily: {
                        sans: ['Roboto', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Table & Printable Styles */
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #0f172a;
            color: #334155;
        }
        .excel-table th, .excel-table td {
            border: 1px solid #cbd5e1;
            padding: 6px 8px;
            text-align: center;
            font-size: 13px;
        }
        .excel-table th {
            background-color: #1b365d;
            color: white;
            font-weight: 600;
        }
        .excel-table tr:nth-child(even) {
            background-color: #f8fafc;
        }
        .excel-table tr:hover {
            background-color: #f1f5f9;
        }
        .score-input::-webkit-inner-spin-button, 
        .score-input::-webkit-outer-spin-button { 
            -webkit-appearance: none; 
            margin: 0; 
        }
        .ham-badge {
            background: linear-gradient(135deg, #ef4444, #991b1b);
            color: white;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            animation: pulse 1.5s infinite;
            display: inline-block;
            font-size: 11px;
            letter-spacing: 0.5px;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.05); }
        }
        .custom-scrollbar::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #1e293b;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-900 min-h-screen text-slate-100 flex flex-col justify-between">

    <header class="bg-slate-950 border-b border-slate-800 sticky top-0 z-40 shadow-xl">
        <div class="max-w-7xl mx-auto px-3 py-2 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-4">
            <!-- Logo & Title -->
            <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-start">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-blue-600 via-cyan-500 to-emerald-400 p-0.5 shadow-lg shadow-cyan-500/20">
                        <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
                            <i class="fa-solid fa-table-tennis-paddle-ball text-2xl text-cyan-400"></i>
                        </div>
                    </div>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-black tracking-wider bg-gradient-to-r from-blue-400 via-teal-300 to-emerald-400 bg-clip-text text-transparent uppercase">
                            BẢNG TỔNG HỢP KÈO 15K
                        </h1>
                        <p class="text-xs text-slate-400 font-medium">Hệ thống quản lý giải đấu & Thống kê kèo Pickleball</p>
                    </div>
                </div>

                <!-- Admin Status Tag (Mobile) -->
                <div class="md:hidden">
                    <button onclick="toggleAdminModal()" id="adminBtnMobile" class="px-2.5 py-1 text-xs rounded-lg font-bold flex items-center gap-1.5 border transition-all bg-slate-800 text-slate-300 border-slate-700">
                        <i class="fa-solid fa-lock text-amber-400"></i>
                        <span id="adminTextMobile">Khách</span>
                    </button>
                </div>
            </div>

            <!-- Quick Action Bar -->
            <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-end">
                <!-- Admin Lock/Unlock Button -->
                <button onclick="toggleAdminModal()" id="adminBtn" class="hidden md:flex px-3 py-1.5 text-xs rounded-lg font-bold items-center gap-1.5 border transition-all bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700">
                    <i id="adminIcon" class="fa-solid fa-lock text-amber-400"></i>
                    <span id="adminText">Quyền: Khách Xem</span>
                </button>

                <!-- Edit Global Settings -->
                <button onclick="openSettingsModal()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-md shadow-blue-900/40">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Cài Đặt Kèo</span>
                </button>

                <!-- Export Excel -->
                <button onclick="exportToExcel()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-md shadow-emerald-900/40">
                    <i class="fa-solid fa-file-excel"></i>
                    <span>Xuất Excel</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-2 sm:px-4 py-4 w-full flex-grow space-y-4">

        <!-- Date Manager Bar -->
        <div class="bg-slate-800/80 rounded-xl p-3 border border-slate-700 shadow-md flex flex-col md:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto custom-scrollbar pb-1 md:pb-0" id="dateTabsContainer">
                <!-- Date tabs generated dynamically -->
            </div>

            <div class="flex items-center gap-2 w-full md:w-auto justify-end border-t md:border-t-0 pt-2 md:pt-0 border-slate-700">
                <button onclick="addNewDate()" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-bold transition flex items-center gap-1">
                    <i class="fa-solid fa-calendar-plus"></i> Thêm Ngày
                </button>
                <button onclick="editCurrentDate()" class="px-2.5 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg text-xs font-medium transition" title="Sửa tên ngày">
                    <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button onclick="deleteCurrentDate()" class="px-2.5 py-1.5 bg-rose-900/50 hover:bg-rose-800 text-rose-200 rounded-lg text-xs font-medium transition border border-rose-700/50" title="Xóa ngày hiện tại">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="bg-slate-800/60 rounded-lg p-3 border border-slate-700/70">
                <p class="text-[11px] text-slate-400 uppercase font-semibold">Kèo Mặc Định</p>
                <p class="text-base font-bold text-emerald-400 mt-0.5">Thắng +<span id="cfgWin">5</span>k / Thua <span id="cfgLoss">-15</span>k</p>
            </div>
            <div class="bg-slate-800/60 rounded-lg p-3 border border-slate-700/70">
                <p class="text-[11px] text-slate-400 uppercase font-semibold">Cài Đặt Bắt Buộc</p>
                <p class="text-base font-bold text-amber-400 mt-0.5">Tối thiểu <span id="cfgMinMatch">4</span> trận (Không đủ: -10k)</p>
            </div>
            <div class="bg-slate-800/60 rounded-lg p-3 border border-slate-700/70">
                <p class="text-[11px] text-slate-400 uppercase font-semibold">Tổng Tiền Đã Nộp</p>
                <p class="text-base font-bold text-cyan-400 mt-0.5"><span id="statPaid">0</span> K</p>
            </div>
            <div class="bg-slate-800/60 rounded-lg p-3 border border-slate-700/70">
                <p class="text-[11px] text-slate-400 uppercase font-semibold">Còn Phải Thu</p>
                <p class="text-base font-bold text-rose-400 mt-0.5"><span id="statUnpaid">0</span> K</p>

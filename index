    <!-- Modal 1: Cài Đặt Kèo (Settings) -->
    <div id="settingsModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-slate-900 border border-slate-700 text-slate-100 rounded-xl w-full max-w-md p-5 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-base text-blue-400 flex items-center gap-2">

                `;
                tbody.appendChild(tr);
            });

            // Update Table Footers
            document.getElementById('sumTotalMatches').textContent = sumMatches;
            document.getElementById('sumWin').textContent = `+${sumWin}`;
            document.getElementById('sumLoss').textContent = sumLoss;
            document.getElementById('sumNet').textContent = sumNet;
            document.getElementById('sumFinal').textContent = sumFinal;

            // Financial Summary Cards
            document.getElementById('statPaid').textContent = sumPaidMoney;
            document.getElementById('statUnpaid').textContent = sumUnpaidMoney;
            document.getElementById('boxPaid').textContent = `${sumPaidMoney} K`;
            document.getElementById('boxUnpaid').textContent = `${sumUnpaidMoney} K`;
            document.getElementById('boxNetFund').textContent = `${sumPaidMoney - sumUnpaidMoney} K`;

            // Render Multi-day Matrix
            renderSummaryMatrixTable();

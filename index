    <!-- Modal 2: Phân Quyền Admin (BTC Authentication) -->
    <div id="adminModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-slate-900 border border-slate-700 text-slate-100 rounded-xl w-full max-w-sm p-5 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-base text-amber-400 flex items-center gap-2">
                    <i class="fa-solid fa-user-shield"></i> PHÂN QUYỀN BTC
                </h3>
                <button onclick="closeAdminModal()" class="text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="text-sm space-y-3">
                <p class="text-xs text-slate-400">
                    Chỉ Ban Tổ Chức có mật khẩu mới có quyền tích chọn trạng thái <span class="text-emerald-400 font-bold">Đã Nộp / Chưa Nộp</span>.
                </p>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Mật Khẩu BTC (Mặc định: 123456)</label>
                    <input type="password" id="adminPasswordInput" placeholder="Nhập mật khẩu..." class="w-full bg-slate-800 border border-slate-700 rounded px-3 py-2 text-white focus:outline-none focus:border-amber-500">
                </div>
            </div>

            <div class="flex justify-between items-center pt-3 border-t border-slate-800">
                <button onclick="logoutAdmin()" id="logoutAdminBtn" class="px-3 py-1.5 bg-rose-900/40 hover:bg-rose-800 text-rose-300 rounded text-xs font-semibold border border-rose-700/50 hidden">
                    Đăng Xuất BTC
                </button>
                <div class="flex gap-2 ml-auto">
                    <button onclick="closeAdminModal()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-xs font-semibold">Đóng</button>
                    <button onclick="authenticateAdmin()" class="px-4 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded text-xs font-bold">Xác Nhận</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        /* -------------------------------------------------------------------------- */
        /* GLOBAL STATE & INITIAL DATA                                                 */
        /* -------------------------------------------------------------------------- */
        
        // Initial Default Players
        const DEFAULT_PLAYERS = [
            "Hải Lùn", "Tú Ca", "Phát Lê", "Đức Anh", 
            "Minh Khơ", "Hùng Sơn", "Tiến Lộc", "Việt Trinh"
        ];

        // Global App Settings
        let appConfig = {
            winBetDefault: 5,        // 5k
            lossBetDefault: -15,     // -15k
            minMatches: 4,           // 4 matches
            penaltyForMinMatches: 10 // -10k if < 4 matches
        };

        // Admin Permission State
        let isAdminLoggedIn = false;

        // Current Active Date ID
        let activeDateId = "";

        // App Data Storage: Dates Dictionary
        let tourneyData = {};

        /* -------------------------------------------------------------------------- */
        /* INITIALIZATION & LOCAL STORAGE                                             */
        /* -------------------------------------------------------------------------- */

        window.onload = function() {
            loadDataFromStorage();
            if (Object.keys(tourneyData).length === 0) {
                // Initialize today date if empty
                const todayStr = getTodayFormatted();
                createNewDateRecord(todayStr);
            } else {
                // Pick today or closest existing date
                const sortedDates = Object.keys(tourneyData).sort().reverse();
                activeDateId = sortedDates[0];
            }

            renderDateTabs();
            renderAllTables();
            updateConfigUI();
        };

        function getTodayFormatted() {
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');
            return `${yyyy}-${mm}-${dd}`;
        }

        function loadDataFromStorage() {
            const savedData = localStorage.getItem('pickleball_tourney_data');
            const savedConfig = localStorage.getItem('pickleball_config');
            
            if (savedData) {
                try { tourneyData = JSON.parse(savedData); } catch (e) { tourneyData = {}; }
            }
            if (savedConfig) {
                try { appConfig = JSON.parse(savedConfig); } catch (e) { }
            }
        }

        function saveDataToStorage() {
            localStorage.setItem('pickleball_tourney_data', JSON.stringify(tourneyData));
            localStorage.setItem('pickleball_config', JSON.stringify(appConfig));
        }

        /* -------------------------------------------------------------------------- */
        /* DATE MANAGEMENT LOGIC                                                      */
        /* -------------------------------------------------------------------------- */

        function createNewDateRecord(dateKey) {
            if (tourneyData[dateKey]) return;

            tourneyData[dateKey] = {
                id: dateKey,
                dateName: formatDateDisplay(dateKey),
                players: DEFAULT_PLAYERS.map(name => ({
                    name: name,
                    isPaid: false,
                    note: "Chưa nộp"
                })),
                matches: [

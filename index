                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-trophy text-amber-400"></i>
                        <h2 class="font-bold text-sm sm:text-base text-white uppercase tracking-wide">
                            BẢNG 1: DANH SÁCH TRẬN ĐẤU
                        </h2>
                    </div>
                    <button onclick="addNewMatch()" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded text-xs font-bold transition flex items-center gap-1 shadow">
                        <i class="fa-solid fa-plus"></i> Thêm Trận
                    </button>
                </div>

                <!-- Match List Responsive Container -->
                <div class="overflow-x-auto custom-scrollbar flex-grow bg-white">
                    <table class="w-full excel-table text-slate-900">
                        <thead>
                            <tr class="bg-navy-900 text-white">
                                <th class="w-10">Trận</th>
                                <th class="w-1/3">Cặp Pick 1</th>
                                <th class="w-1/3">Cặp Pick 2</th>
                                <th class="w-24">Tỷ Số</th>
                                <th class="w-28">Chế Độ Kèo</th>

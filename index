                                </td>
                                <td colspan="3" class="text-right text-xs text-slate-500">
                                    *Tỷ số có số 0 tự động nhân đôi kèo (HẦM)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- RIGHT COLUMN: Table 2 - Player Stats & Finances (5 cols) -->
            <div class="lg:col-span-5 bg-slate-900 rounded-xl border border-slate-700/80 shadow-2xl overflow-hidden flex flex-col">
                <!-- Table Header Bar -->
                <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 p-3 border-b border-slate-700 flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-users-rectangle text-cyan-400"></i>
                        <h2 class="font-bold text-sm sm:text-base text-white uppercase tracking-wide">
                            BẢNG 2: THỐNG KÊ & THÀNH TIỀN
                        </h2>
                    </div>
                    <button onclick="openAddPlayerModal()" class="px-2.5 py-1 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded text-xs font-semibold transition">
                        <i class="fa-solid fa-user-plus"></i> Thêm VĐV
                    </button>
                </div>

                <!-- Stats Table Container -->

                "Loại Kèo": m.betType === 'SPECIAL_0_25' ? '0k/-25k' : (m.betType === 'CUSTOM' ? 'Tự Do' : 'Mặc Định')
            }));

            const matchWs = XLSX.utils.json_to_sheet(matchRows);
            XLSX.utils.book_append_sheet(wb, matchWs, "Danh Sach Tran");

            const playerRows = statsList.map(p => ({
                "Pick Thủ": p.name,
                "Số Trận": p.matchCount,
                "Thắng (K)": p.winMoney,
                "Thua (K)": p.lossMoney,
                "Thành Tiền (K)": p.netMoney,
                "Mang Về (K)": p.finalMoney,
                "Trạng Thái": p.isPaid ? "Đã nộp" : "Chưa nộp"
            }));

            const playerWs = XLSX.utils.json_to_sheet(playerRows);
            XLSX.utils.book_append_sheet(wb, playerWs, "Thong Ke VDV");

            // Save File
            XLSX.writeFile(wb, `Pickleball_Keo15K_${activeDateId}.xlsx`);
        }
    </script>
</body>
</html>

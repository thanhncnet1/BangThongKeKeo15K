                    <td class="font-bold ${p.netMoney >= 0 ? 'text-emerald-700' : 'text-rose-700'}">${p.netMoney}</td>
                    <td class="font-extrabold ${p.finalMoney >= 0 ? 'text-blue-700' : 'text-rose-700'} bg-amber-50">${p.finalMoney}</td>
                    <td>
                        <input type="checkbox" ${p.isPaid ? 'checked' : ''} 

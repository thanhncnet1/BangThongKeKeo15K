                                <th class="text-left min-w-[110px]">PICK THỦ</th>
                                <th class="w-12">Số Trận</th>
                                <th class="w-16">Thắng</th>
                                <th class="w-16">Thua</th>
                                <th class="w-20">Thành Tiền</th>
                                <th class="w-20">Mang Về</th>
                                <th class="w-14">Thực Tế</th>
                                <th class="w-20">Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody id="playerTableBody">
                            <!-- Player rows inserted via JS -->
                        </tbody>
                        <tfoot>
                            <tr class="bg-amber-100 font-bold text-slate-900 text-xs">
                                <td class="text-left font-extrabold">TỔNG CỘNG</td>
                                <td id="sumTotalMatches">0</td>
                                <td id="sumWin" class="text-emerald-700">0</td>
                                <td id="sumLoss" class="text-rose-700">0</td>
                                <td id="sumNet">0</td>
                                <td id="sumFinal" class="text-blue-800 font-extrabold">0</td>

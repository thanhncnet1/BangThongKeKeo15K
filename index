        /* -------------------------------------------------------------------------- */
        /* STATS CALCULATIONS & TABLE 2 RENDER                                        */
        /* -------------------------------------------------------------------------- */

        function calculatePlayerStats() {
            const currentData = tourneyData[activeDateId];
            if (!currentData) return [];

            const statsMap = {};

            // Initialize all current players
            currentData.players.forEach(p => {
                statsMap[p.name] = {
                    name: p.name,
                    matchCount: 0,
                    winMoney: 0,
                    lossMoney: 0,
                    netMoney: 0,
                    finalMoney: 0,
                    isPaid: p.isPaid || false,
                    note: p.note || (p.isPaid ? "Đã nộp" : "Chưa nộp")
                };
            });

            // Calculate money from matches
            currentData.matches.forEach(m => {
                if (m.score1 === null || m.score2 === null) return;

                const isHam = (m.score1 === 0 || m.score2 === 0);
                
                let winRate = appConfig.winBetDefault;
                let lossRate = appConfig.lossBetDefault;

                if (m.betType === 'SPECIAL_0_25') {
                    winRate = 0;
                    lossRate = -25;
                } else if (m.betType === 'CUSTOM') {
                    winRate = m.customWin || 0;
                    lossRate = m.customLoss || 0;
                }

                if (isHam) {
                    winRate *= 2;
                    lossRate *= 2;
                }

                const team1Won = m.score1 > m.score2;
                const team2Won = m.score2 > m.score1;

                // Process Team 1
                m.team1.forEach(pName => {
                    if (pName && statsMap[pName]) {
                        statsMap[pName].matchCount += 1;
                        if (team1Won) {
                            statsMap[pName].winMoney += winRate;
                        } else if (team2Won) {
                            statsMap[pName].lossMoney += lossRate;
                        }
                    }
                });

                // Process Team 2
                m.team2.forEach(pName => {
                    if (pName && statsMap[pName]) {
                        statsMap[pName].matchCount += 1;
                        if (team2Won) {
                            statsMap[pName].winMoney += winRate;
                        } else if (team1Won) {
                            statsMap[pName].lossMoney += lossRate;
                        }
                    }
                });
            });

            // Calculate Net & Final Money (Rule: < 4 matches penalty)
            Object.values(statsMap).forEach(p => {
                p.netMoney = p.winMoney + p.lossMoney;

                if (p.matchCount < appConfig.minMatches) {
                    // Penalty rule applied if not enough matches played
                    p.finalMoney = p.netMoney - appConfig.penaltyForMinMatches;
                } else {
                    p.finalMoney = p.netMoney;
                }
            });

            return Object.values(statsMap);
        }

        function renderPlayerStatsTable() {
            const tbody = document.getElementById('playerTableBody');
            tbody.innerHTML = '';

            const statsList = calculatePlayerStats();

            let sumMatches = 0;
            let sumWin = 0;
            let sumLoss = 0;
            let sumNet = 0;
            let sumFinal = 0;
            let sumPaidMoney = 0;
            let sumUnpaidMoney = 0;

            statsList.forEach((p, idx) => {
                sumMatches += p.matchCount;
                sumWin += p.winMoney;
                sumLoss += p.lossMoney;
                sumNet += p.netMoney;
                sumFinal += p.finalMoney;

                if (p.isPaid) {
                    sumPaidMoney += p.finalMoney;
                } else {
                    sumUnpaidMoney += p.finalMoney;
                }

                const tr = document.createElement('tr');
                
                // Color formatting for notes
                let noteClass = "text-slate-600";
                if (p.isPaid) noteClass = "text-emerald-600 font-bold";
                else noteClass = "text-rose-600 font-bold";

                tr.innerHTML = `
                    <td class="font-bold text-left text-slate-800 flex items-center justify-between">
                        <span>${p.name}</span>
                        <button onclick="removePlayer('${p.name}')" class="text-slate-400 hover:text-rose-600 text-[10px] ml-1" title="Xóa VĐV">

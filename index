        /* -------------------------------------------------------------------------- */
        /* MULTI-DAY SUMMARY MATRIX TABLE                                             */
        /* -------------------------------------------------------------------------- */

        function renderSummaryMatrixTable() {
            const matrixTable = document.getElementById('summaryMatrixTable');
            matrixTable.innerHTML = '';

            const dateKeys = Object.keys(tourneyData).sort();
            if (dateKeys.length === 0) return;

            // Collect unique list of all players across all dates
            const allPlayerNamesSet = new Set();
            dateKeys.forEach(k => {
                tourneyData[k].players.forEach(p => allPlayerNamesSet.add(p.name));
            });
            const allPlayerNames = Array.from(allPlayerNamesSet);

            // Compute Stats per Date
            const dateStatsMap = {};
            dateKeys.forEach(k => {
                // Temporary set active Date ID to calculate
                const tempBackup = activeDateId;
                activeDateId = k;
                dateStatsMap[k] = calculatePlayerStats();
                activeDateId = tempBackup;
            });

            // Build Table Header
            let theadHtml = `<thead><tr class="bg-navy-900 text-white">`;
            theadHtml += `<th class="text-left">PICK THỦ</th>`;
            dateKeys.forEach(k => {
                theadHtml += `<th>${tourneyData[k].dateName}</th>`;
            });
            theadHtml += `<th class="bg-blue-900">TỔNG CỘNG</th></tr></thead>`;

            // Build Table Body
            let tbodyHtml = `<tbody>`;
            allPlayerNames.forEach(pName => {
                tbodyHtml += `<tr><td class="font-bold text-left text-slate-800">${pName}</td>`;
                let totalPlayerMoney = 0;

                dateKeys.forEach(k => {
                    const stats = dateStatsMap[k];
                    const pStat = stats.find(s => s.name === pName);
                    if (pStat) {
                        const money = pStat.finalMoney;
                        totalPlayerMoney += money;
                        const colorClass = money >= 0 ? 'text-emerald-700 font-semibold' : 'text-rose-700 font-semibold';
                        tbodyHtml += `<td class="${colorClass}">${money} k</td>`;
                    } else {
                        tbodyHtml += `<td class="text-slate-400">-</td>`;
                    }
                });

                const totalColorClass = totalPlayerMoney >= 0 ? 'text-blue-800 font-extrabold bg-blue-50' : 'text-rose-800 font-extrabold bg-rose-50';
                tbodyHtml += `<td class="${totalColorClass}">${totalPlayerMoney} k</td></tr>`;
            });
            tbodyHtml += `</tbody>`;

            matrixTable.innerHTML = theadHtml + tbodyHtml;
        }

